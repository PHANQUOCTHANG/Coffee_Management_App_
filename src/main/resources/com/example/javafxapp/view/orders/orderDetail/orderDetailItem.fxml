<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxHeight="100.0" maxWidth="405.0" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="100.0" prefWidth="405.0" 
      style="-fx-background-color: #ffffff; -fx-border-color: #e8ecf4; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);" 
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.javafxapp.Controller.Admin.Order.OrderDetailItemController">
   <children>
      <!-- Hình ảnh sản phẩm với border bo tròn -->
      <VBox alignment="CENTER" prefHeight="100.0" prefWidth="90.0">
         <children>
            <ImageView fx:id="imgProduct" fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" 
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </ImageView>
         </children>
         <padding>
            <Insets left="10.0" right="5.0" />
         </padding>
      </VBox>

      <!-- Separator -->
      <Separator orientation="VERTICAL" prefHeight="80.0" style="-fx-background-color: #f1f3f4;" />

      <!-- Thông tin sản phẩm -->
      <VBox alignment="TOP_LEFT" prefHeight="100.0" prefWidth="140.0">
         <children>
            <!-- Tên sản phẩm -->
            <Label fx:id="unitName" maxWidth="130.0" text="Cà phê sữa" wrapText="true"
                   style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
               <font>
                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>

            <!-- Giá và số lượng -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label fx:id="productPriceLabel" text="25k"
                         style="-fx-text-fill: #7f8c8d;">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <Label fx:id="cntItem2" text="x 1"
                         style="-fx-text-fill: #95a5a6;">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="8.0" />
               </VBox.margin>
            </HBox>

            <!-- Nút xóa -->
            <JFXButton fx:id="deleteBtn" onAction="#deleteUnit" prefHeight="28.0" prefWidth="28.0" 
                       style="-fx-background-color: #fee; -fx-background-radius: 14; -fx-cursor: hand;"
                       text="">
               <graphic>
                  <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../Images/bin.png" />
                     </image>
                  </ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </JFXButton>
         </children>
         <padding>
            <Insets left="10.0" right="5.0" top="8.0" />
         </padding>
      </VBox>

      <!-- Separator -->
      <Separator orientation="VERTICAL" prefHeight="80.0" style="-fx-background-color: #f1f3f4;" />

      <!-- Giá và điều chỉnh số lượng -->
      <VBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="130.0">
         <children>
            <!-- Tổng giá -->
            <Label fx:id="unitPrice" alignment="CENTER_RIGHT" text="25,000đ"
                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold;">
               <font>
                  <Font size="16.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="12.0" />
               </VBox.margin>
            </Label>

            <!-- Bộ điều chỉnh số lượng -->
            <HBox alignment="CENTER" spacing="0.0" 
                  style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;">
               <children>
                  <!-- Nút giảm -->
                  <JFXButton fx:id="decBtn" onAction="#dec" prefHeight="36.0" prefWidth="36.0" 
                             style="-fx-background-color: transparent; -fx-background-radius: 18; -fx-cursor: hand;"
                             text="−">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </JFXButton>

                  <!-- Số lượng -->
                  <Label fx:id="cntItem" alignment="CENTER" prefHeight="36.0" prefWidth="40.0" text="1"
                         style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>

                  <!-- Nút tăng -->
                  <JFXButton fx:id="incBtn" onAction="#inc" prefHeight="36.0" prefWidth="36.0"
                             style="-fx-background-color: transparent; -fx-background-radius: 18; -fx-cursor: hand;"
                             text="+">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </JFXButton>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="5.0" right="15.0" top="8.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
</HBox>