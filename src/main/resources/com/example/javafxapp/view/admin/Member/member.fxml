<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" stylesheets="@../../Styles/product.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafxapp.Controller.Admin.Member.MemberController">
    <BorderPane prefHeight="1200.0" prefWidth="1600.0" style="-fx-background-color: #F7F9FC;">
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #5C4033, #3C2F2F); -fx-border-color: #E0E6ED; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
                <children>
                    <Label prefHeight="50.0" styleClass="page-title" text="Quản lý hội viên ">
                        <font>
                            <Font name="Arial Bold" size="26.0" />
                        </font>
                        <padding>
                            <Insets left="25.0" right="20.0" />
                        </padding>
                    </Label>
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                        <children>
                            <JFXButton alignment="CENTER" contentDisplay="LEFT" onAction="#deleteAll" prefHeight="45.0" styleClass="delete-button" text="Xóa đã chọn">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@../../Images/bin.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets right="15.0" />
                                </HBox.margin>
                            </JFXButton>
                            <JFXButton alignment="CENTER" contentDisplay="LEFT" onAction="#addMember" prefHeight="45.0" styleClass="primary-button" text="Thêm hội viên">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                                <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@../../Images/circleplus.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                                <HBox.margin>
                                    <Insets right="25.0" />
                                </HBox.margin>
                            </JFXButton>
                        </children>
                        <padding>
                            <Insets right="10.0" />
                        </padding>
                    </HBox>
                </children>
            </HBox>
        </top>
        <center>
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <children>
                    <!-- Search Section -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                            <HBox alignment="CENTER" maxWidth="600.0" prefWidth="400.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 4px; -fx-border-color: #E0E6ED; -fx-border-radius: 4px;" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets left="10.0" right="10.0" />
                                </padding>
                                <children>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@../../Images/searchicon.png" />
                                        </image>
                                    </ImageView>
                                    <TextField fx:id="searchField" onAction="#searchMember" promptText="Tìm kiếm theo số điện thoại" style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                </children>
                                <HBox.margin>
                                    <Insets />
                                </HBox.margin>
                            </HBox>
                            <JFXButton onAction="#searchMember" prefHeight="40.0" prefWidth="120.0" styleClass="search-button" text="Tìm kiếm">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </JFXButton>
                        </children>
                    </HBox>

                    <!-- Table Section -->
                    <AnchorPane VBox.vgrow="ALWAYS">
                        <children>
                            <VBox spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
                                <children>
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label styleClass="section-title" text="Tất cả hội viên ">
                                                <font>
                                                    <Font name="System Bold" size="18.0" />
                                                </font>
                                            </Label>
                                            <Label fx:id="memberCountLabel" styleClass="counter-label" text="(0 hội viên )">
                                                <HBox.margin>
                                                    <Insets left="10.0" />
                                                </HBox.margin>
                                                <font>
                                                    <Font size="14.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </HBox>

                                    <VBox spacing="0" VBox.vgrow="ALWAYS">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" prefHeight="50.0" styleClass="table-header-bar">
                                                <children>
                                                    <JFXCheckBox fx:id="checkBoxAll" onAction="#checkBoxAll" text="Chọn tất cả">
                                                        <font>
                                                            <Font name="System Bold" size="14.0" />
                                                        </font>
                                                        <HBox.margin>
                                                            <Insets left="12.0" />
                                                        </HBox.margin>
                                                    </JFXCheckBox>
                                                </children>
                                            </HBox>

                                            <TableView fx:id="memberTable" styleClass="product-table" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="checkBoxColumn" maxWidth="60.0" minWidth="50.0" prefWidth="60.0" />
                                                    <TableColumn fx:id="indexColumn" maxWidth="60.0" minWidth="50.0" prefWidth="60.0" resizable="false" text="STT" />
                                                    <TableColumn fx:id="phoneColumn" maxWidth="500.0" minWidth="250.0" prefWidth="400.0" text="Số điện thoại" />
                                                    <TableColumn fx:id="pointColumn" maxWidth="500.0" minWidth="250.0" prefWidth="400.0" text="Điểm tích lũy" />
                                                    <TableColumn fx:id="actionColumn" maxWidth="180.0" minWidth="150.0" prefWidth="180.0" text="Hành động" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </children>
                    </AnchorPane>

                </children>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
