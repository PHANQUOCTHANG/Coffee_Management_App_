<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" stylesheets="@../../Styles/product.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafxapp.Controller.Admin.WareHouse.WareHouseController">
    <children>
        <BorderPane prefHeight="1200.0" prefWidth="1600.0" style="-fx-background-color: #F7F9FC;">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #5C4033, #3C2F2F); -fx-border-color: #E0E6ED; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
                    <children>
                        <Label prefHeight="50.0" styleClass="page-title" text="Quản lý kho hàng">
                            <font><Font name="Arial Bold" size="26.0" /></font>
                            <padding><Insets left="25.0" right="20.0" /></padding>
                        </Label>
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <JFXButton onAction="#deleteAll" prefHeight="45.0" styleClass="delete-button" text="Xóa đã chọn">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                    <graphic>
                                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                            <image><Image url="@../../Images/bin.png" /></image>
                                        </ImageView>
                                    </graphic>
                                    <HBox.margin><Insets right="15.0" /></HBox.margin>
                                </JFXButton>
                                <JFXButton onAction="#addWarehouse" prefHeight="45.0" styleClass="primary-button" text="Thêm sản phẩm mới">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                    <graphic>
                                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                            <image><Image url="@../../Images/circleplus.png" /></image>
                                        </ImageView>
                                    </graphic>
                                    <HBox.margin><Insets right="25.0" /></HBox.margin>
                                </JFXButton>
                                <JFXButton fx:id="importButton" onAction="#addWarehouseFromExcel" prefHeight="45.0" styleClass="primary-button" text="Thêm từ xcel">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                    <graphic>
                                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                            <image><Image url="@../../Images/excels.png" /></image>
                                        </ImageView>
                                    </graphic>
                                    <HBox.margin><Insets right="25.0" /></HBox.margin>
                                </JFXButton>
                            </children>
                            <padding><Insets right="10.0" /></padding>
                        </HBox>
                    </children>
                    <effect><DropShadow radius="1.5"><color><Color opacity="0.1" /></color></DropShadow></effect>
                </HBox>
            </top>

            <center>
                <VBox BorderPane.alignment="CENTER">
                    <children>
                        <AnchorPane styleClass="card">
                            <children>
                                <VBox spacing="15.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="section-title" text="Tất cả mặt hàng">
                                                    <font><Font name="System Bold" size="18.0" /></font>
                                                </Label>
                                                <Label fx:id="warehouseCountLabel" styleClass="counter-label" text="(0 sản phẩm)">
                                                    <font><Font size="14.0" /></font>
                                                    <HBox.margin><Insets left="10.0" /></HBox.margin>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <HBox spacing="15.0">
                                            <children>
                                                <ComboBox fx:id="categoryComboBox" onAction="#filterAction" prefHeight="42.0" prefWidth="200.0" promptText="Danh mục" styleClass="filter-combo" />
                                                <ComboBox fx:id="statusComboBox" onAction="#filterAction" prefHeight="42.0" prefWidth="200.0" promptText="Trạng thái" styleClass="filter-combo" />
                                                <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="450.0" styleClass="search-box">
                                                    <children>
                                                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                            <image><Image url="@../../Images/searchicon.png" /></image>
                                                            <HBox.margin><Insets left="15.0" /></HBox.margin>
                                                        </ImageView>
                                                        <TextField fx:id="searchField" onAction="#searchWareHouse" promptText="Tìm kiếm theo tên sản phẩm" styleClass="search-field" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                                <JFXButton onAction="#searchWareHouse" prefHeight="42.0" styleClass="search-button" text="Tìm kiếm" />
                                                <JFXButton fx:id="resetButton" onAction="#resetFilters" prefHeight="42.0" styleClass="reset-button" text="Đặt lại">
                                                    <HBox.margin><Insets left="5.0" /></HBox.margin>
                                                </JFXButton>
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding><Insets bottom="20.0" left="25.0" right="25.0" top="20.0" /></padding>
                                </VBox>
                            </children>
                            <VBox.margin><Insets bottom="10.0" left="20.0" right="20.0" top="0.0" /></VBox.margin>
                            <effect><DropShadow radius="1.5"><color><Color opacity="0.1" /></color></DropShadow></effect>
                        </AnchorPane>

                        <AnchorPane VBox.vgrow="ALWAYS">
                            <children>
                                <VBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                    <children>
                                        <AnchorPane styleClass="card" VBox.vgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" prefHeight="50.0" styleClass="table-header-bar">
                                                            <children>
                                                                <JFXCheckBox fx:id="checkBoxAll" onAction="#checkBoxAll" text="Chọn tất cả">
                                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                                    <HBox.margin><Insets left="12.0" /></HBox.margin>
                                                                </JFXCheckBox>
                                                                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <JFXButton fx:id="exportButton" onAction="#exportData" styleClass="export-button" text="Xuất Excel">
                                                                            <graphic>
                                                                                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                                                                                    <image><Image url="@../../Images/excels.png" /></image>
                                                                                </ImageView>
                                                                            </graphic>
                                                                        </JFXButton>
                                                                        <ComboBox fx:id="sortComboBox" prefHeight="35.0" prefWidth="160.0" promptText="Sắp xếp theo" styleClass="filter-combo" />
                                                                    </children>
                                                                    <HBox.margin><Insets right="15.0" /></HBox.margin>
                                                                </HBox>
                                                            </children>
                                                            <padding><Insets bottom="8.0" top="8.0" /></padding>
                                                        </HBox>

                                                        <TableView fx:id="warehouseTable" styleClass="product-table" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="checkBoxColumn" prefWidth="60.0" />
                                                                <TableColumn fx:id="indexColumn" prefWidth="60.0" resizable="false" text="STT" />
                                                                <TableColumn fx:id="imageColumn" prefWidth="180.0" text="Ảnh" />
                                                                <TableColumn fx:id="nameColumn" prefWidth="400.0" text="Tên sản phẩm" />
                                                                <TableColumn fx:id="quantityColumn" prefWidth="400.0" text="Số lượng" />
                                                                <TableColumn fx:id="statusColumn" prefWidth="180.0" text="Hết hàng" />
                                                                <TableColumn fx:id="actionColumn" prefWidth="180.0" text="Hành động" />
                                                            </columns>
                                                        </TableView>

                                                        <Pagination fx:id="pagination" maxPageIndicatorCount="5" styleClass="pagination-controls" />
                                                    </children>
                                                </VBox>
                                            </children>
                                            <effect><DropShadow radius="1.5"><color><Color opacity="0.1" /></color></DropShadow></effect>
                                        </AnchorPane>
                                    </children>
                                </VBox>
                            </children>
                            <VBox.margin><Insets bottom="20.0" left="20.0" right="20.0" /></VBox.margin>
                        </AnchorPane>
                    </children>
                </VBox>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #5C4033, #3C2F2F);" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="statusLabel" text="Đang hiển thị 1-10 của 100 sản phẩm">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                    <padding><Insets right="25.0" /></padding>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
