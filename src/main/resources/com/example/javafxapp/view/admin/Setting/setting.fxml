<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafxapp.Controller.Admin.SettingController">
    <top>
        <!-- Header Section -->
        <VBox style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%); -fx-padding: 25px;">
            <Label text="Cài Đặt" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label text="Tùy chỉnh các tùy chọn ứng dụng của bạn" textFill="#E8E8E8">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20.0" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>

                <!-- General Settings Card -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-padding: 25px;">
                    <Label text="Cài Đặt Chung" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Separator />

                    <!-- Language Setting -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Ngôn Ngữ" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Chọn ngôn ngữ ưu tiên của bạn" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <ComboBox fx:id="languageComboBox" prefWidth="150.0" style="-fx-background-radius: 8px;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Tiếng Việt" />
                                    <String fx:value="English" />
                                    <String fx:value="中文" />
                                    <String fx:value="日本語" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </HBox>

                    <!-- Theme Setting -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Giao Diện" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Chuyển đổi giữa chế độ sáng và tối" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <ToggleButton fx:id="themeToggle" style="-fx-background-radius: 20px; -fx-padding: 8px 16px;" text="Chế Độ Tối" />
                    </HBox>

                    <!-- Auto Start Setting -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0" />
                </VBox>

                <!-- Notifications Card -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-padding: 25px;">
                    <Label text="Thông Báo" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Separator />

                    <!-- Push Notifications -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Thông Báo Đẩy" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Nhận thông báo đẩy trên máy tính" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <CheckBox fx:id="pushNotificationCheckBox" selected="true" />
                    </HBox>

                    <!-- Email Notifications -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Thông Báo Email" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Nhận thông báo qua email cho các cập nhật quan trọng" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <CheckBox fx:id="emailNotificationCheckBox" />
                    </HBox>

                    <!-- Sound Effects -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Âm Thanh" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Phát âm thanh cho thông báo và cảnh báo" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <CheckBox fx:id="soundEffectsCheckBox" selected="true" />
                    </HBox>
                </VBox>

                <!-- Privacy & Security Card -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-padding: 25px;">
                    <Label text="Bảo Mật &amp; Quyền Riêng Tư" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Separator />

                    <!-- Auto Lock -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Khóa Tự Động" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Tự động khóa sau khi không hoạt động" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <ComboBox fx:id="autoLockComboBox" prefWidth="120.0" style="-fx-background-radius: 8px;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Không bao giờ" />
                                    <String fx:value="5 phút" />
                                    <String fx:value="15 phút" />
                                    <String fx:value="30 phút" />
                                    <String fx:value="1 giờ" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </HBox>

                    <!-- Data Collection -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Phân Tích Dữ Liệu" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Giúp cải thiện ứng dụng bằng cách chia sẻ dữ liệu sử dụng" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <CheckBox fx:id="analyticsCheckBox" />
                    </HBox>
                </VBox>

                <!-- Performance Card -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-padding: 25px;">
                    <Label text="Hiệu Suất" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Separator />

                    <!-- Performance Mode -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Chế Độ Hiệu Suất" textFill="#34495e">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label text="Tối ưu hóa hiệu suất ứng dụng" textFill="#7f8c8d">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                        </VBox>
                        <ComboBox fx:id="performanceModeComboBox" prefWidth="150.0" style="-fx-background-radius: 8px;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Cân Bằng" />
                                    <String fx:value="Hiệu Suất Cao" />
                                    <String fx:value="Tiết Kiệm Pin" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </HBox>

                    <!-- Cache Size -->
                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Kích Thước Bộ Nhớ Đệm" textFill="#34495e">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label text="Điều chỉnh kích thước bộ nhớ đệm để có hiệu suất tốt hơn" textFill="#7f8c8d">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </VBox>
                            <Label fx:id="cacheSizeLabel" text="512 MB" textFill="#3498db">
                                <font>
                                    <Font name="System Bold" size="12.0" />
                                </font>
                            </Label>
                        </HBox>
                        <Slider fx:id="cacheSizeSlider" max="2048.0" min="128.0" value="512.0" />
                    </VBox>
                </VBox>
                <!-- Account Settings Card -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-padding: 25px;">
                    <Label text="Cài Đặt Tài Khoản" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Separator />

                    <!-- Username Change -->
                    <VBox spacing="8.0">
                        <Label text="Tên Đăng Nhập" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="Thay đổi tên đăng nhập của bạn" textFill="#7f8c8d">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <TextField fx:id="accountNameTextField" promptText="Nhập tên đăng nhập mới" prefWidth="250.0"
                                       style="-fx-background-radius: 8px; -fx-padding: 10px;" />
                            <Button fx:id="changeAccountNameButton" text="Thay Đổi" onAction="#handleChangeAccountName"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 8px 16px;" />
                        </HBox>
                    </VBox>

                    <!-- Password Change -->
                    <VBox spacing="8.0">
                        <Label text="Mật Khẩu" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="Cập nhật mật khẩu để bảo mật tài khoản" textFill="#7f8c8d">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>

                        <!-- Current Password -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Mật khẩu hiện tại:" prefWidth="120.0" textFill="#34495e">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                            <PasswordField fx:id="currentPasswordField" promptText="Nhập mật khẩu hiện tại"
                                           prefWidth="200.0" style="-fx-background-radius: 8px; -fx-padding: 8px;" />
                        </HBox>

                        <!-- New Password -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Mật khẩu mới:" prefWidth="120.0" textFill="#34495e">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                            <PasswordField fx:id="newPasswordField" promptText="Nhập mật khẩu mới"
                                           prefWidth="200.0" style="-fx-background-radius: 8px; -fx-padding: 8px;" />
                        </HBox>

                        <!-- Confirm New Password -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Xác nhận:" prefWidth="120.0" textFill="#34495e">
                                <font>
                                    <Font size="12.0" />
                                </font>
                            </Label>
                            <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu mới"
                                           prefWidth="200.0" style="-fx-background-radius: 8px; -fx-padding: 8px;" />
                            <Button fx:id="changePasswordButton" text="Đổi Mật Khẩu" onAction="#handleChangePassword"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 8px 16px;" />
                        </HBox>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <!-- Footer with Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-padding: 20px;">
            <Button fx:id="resetButton" mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 10px 20px;" text="Khôi Phục Mặc Định" />
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 10px 20px;" text="Hủy" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 10px 20px;" text="Lưu Thay Đổi" />
        </HBox>
    </bottom>
</BorderPane>